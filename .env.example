# PostgreSQL connection string (Neon). Use a different database per
# environment (development / staging / production) — never share one.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth.js
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Public app URL, used to build invitation links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 32-byte key (base64), used to encrypt personal data (names, notes, phone
# numbers, locations, birth dates) at the application layer before it is
# stored in the database. Generate one per environment with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEVER reuse the same key across dev/staging/production, and never commit it.
ENCRYPTION_KEY="change-me"
